# Copy to .env and fill in. Never commit .env.
# model: answers are written by a language model from the retrieved passages only.
# extractive: quotes passages word for word, no model (synthetic test data only).
LLM_PROVIDER=model

# Open model through an OpenAI-compatible API: Ollama's cloud (https://ollama.com/v1, with an API key)
# or Ollama on your own computer (http://localhost:11434/v1, no key)
OPENAI_COMPAT_BASE_URL=https://ollama.com/v1
OPENAI_COMPAT_MODEL=gpt-oss:120b
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_TIMEOUT=
# reasoning models only (OpenRouter): off, minimal, low, medium or high; empty = the model's default
OPENAI_COMPAT_REASONING=
# second-reading calls made at the same time (3 for free hosts; 8 is fine on OpenRouter)
MUHAWIR_PARALLEL_CHECKS=
# 1 = log each model call's time and tokens
MUHAWIR_TIMING=

# Optional backup: Gemini (used when the open model fails or its quota is used up)
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional natural read-aloud (Azure Speech); without both, browser speech is used.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional: Claude (used first when set)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Passages sent to the model per question (fewer = faster on a slow machine)
MUHAWIR_PASSAGES=

# Optional hybrid vector search (off unless 1; needs vectors built with python -m muhawir.vectors build)
MUHAWIR_VECTORS=

# 0 = second reading checks all sentences in one request (fewer requests, but lenient); default: one per sentence
MUHAWIR_READ_EACH_SENTENCE=

# 1 = add the reason for not answering to each response (for testing)
MUHAWIR_DEBUG=
